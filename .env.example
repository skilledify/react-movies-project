# OMDb API напрямую из браузера НЕ вызывается: запросы идут через
# серверный прокси (Netlify Function), а ключ хранится в переменной
# окружения Netlify — OMDB_API_KEY (Site configuration -> Environment variables).
# Ключ OMDb: https://www.omdbapi.com/apikey.aspx
#
# Этот файл НЕ содержит секретов. Здесь только публичный адрес прокси.
VITE_OMDB_API_URL=https://react-movies-api.netlify.app/api/omdb
